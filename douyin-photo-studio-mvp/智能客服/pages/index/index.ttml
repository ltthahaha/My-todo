<view class="page">
  <view class="hero">
    <view class="eyebrow">{{studioName}} · 官方小程序</view>
    <view class="title">拍摄前有问题？<br />先问智能客服</view>
    <view class="subtitle">快速了解套餐、价格、服装、出片时间和预约流程。</view>
    <button class="primary-button" bindtap="goChat">开始咨询</button>
  </view>

  <view class="section-title">
    <view class="section-heading">选择你想了解的服务</view>
    <view class="section-note">在线咨询</view>
  </view>

  <view class="service-list">
    <block tt:for="{{services}}" tt:key="key">
      <view class="service-card" data-service="{{item.key}}" bindtap="goService">
        <view class="service-icon">{{item.icon}}</view>
        <view class="service-copy">
          <view class="service-title">{{item.title}}</view>
          <view class="service-description">{{item.description}}</view>
        </view>
        <view class="arrow">›</view>
      </view>
    </block>
  </view>

  <view class="trust-note">
    <view class="trust-title">不确定的问题会转人工</view>
    <view class="trust-text">客服只根据门店已确认的套餐和规则回答，避免给你错误承诺。</view>
  </view>
</view>
