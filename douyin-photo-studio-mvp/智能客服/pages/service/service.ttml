<view class="page">
  <view class="header-card">
    <view class="eyebrow">映白摄影</view>
    <view class="title">{{title}}</view>
    <view class="description">{{description}}</view>
  </view>

  <view class="section-heading">你可能想了解</view>
  <view class="question-list">
    <block tt:for="{{questions}}" tt:key="*this">
      <view class="question-card" data-question="{{item}}" bindtap="askQuestion">
        <view>{{item}}</view>
        <view class="arrow">›</view>
      </view>
    </block>
  </view>

  <button class="primary-button" bindtap="openLead">填写预约意向</button>
</view>
