.page {
  min-height: 100vh;
  padding: 22px 20px 40px;
}

.header-card {
  padding: 24px 20px;
  border-radius: 18px;
  background: #eaf3ff;
}

.eyebrow {
  color: #5d88bd;
  font-size: 12px;
}

.title {
  margin-top: 12px;
  color: #172334;
  font-size: 26px;
  font-weight: 700;
}

.description {
  margin-top: 8px;
  color: #667384;
  font-size: 14px;
  line-height: 1.6;
}

.section-heading {
  margin: 26px 2px 12px;
  color: #20262e;
  font-size: 18px;
  font-weight: 700;
}

.question-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.question-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  border: 1px solid #e4e9ef;
  border-radius: 14px;
  background: #fff;
  color: #303943;
  font-size: 14px;
}

.arrow {
  color: #9aa7b5;
  font-size: 24px;
}

.primary-button {
  margin-top: 24px;
  background: #5f9df7;
  color: #fff;
}
