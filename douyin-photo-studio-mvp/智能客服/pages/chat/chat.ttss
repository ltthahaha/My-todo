.page {
  min-height: 100vh;
  padding: 16px;
}

.chat-card {
  overflow: hidden;
  border: 1px solid #e4e9ef;
  border-radius: 16px;
  background: #fff;
}

.message-list {
  height: 600px;
  padding: 16px;
  background: #f8fafc;
}

.message {
  display: flex;
  margin-bottom: 12px;
}

.message.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 78%;
  padding: 10px 12px;
  border-radius: 12px;
  background: #fff;
  color: #303943;
  font-size: 14px;
  line-height: 1.6;
}

.message.user .bubble {
  background: #5f9df7;
  color: #fff;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 12px;
  background: #f8fafc;
}

.quick-button {
  margin: 0;
  padding: 6px 10px;
  border: 1px solid #cfe0f8;
  border-radius: 999px;
  background: #edf5ff;
  color: #4d8fe8;
  font-size: 12px;
  line-height: 1.4;
}

.input-row {
  display: flex;
  gap: 8px;
  padding: 12px;
  border-top: 1px solid #e4e9ef;
}

.input {
  flex: 1;
  height: 42px;
  padding: 0 12px;
  border: 1px solid #e1e7ed;
  border-radius: 10px;
  background: #fff;
}

.send-button,
.lead-button {
  background: #5f9df7;
  color: #fff;
  font-size: 14px;
}

.send-button {
  width: 72px;
  margin: 0;
}

.lead-button {
  margin-top: 16px;
}
