.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 14px 14px 24px;
  background: #f6f7f6;
}

.chat-card {
  overflow: hidden;
  border: 1px solid #e4ebe7;
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 6px 20px rgba(37, 53, 46, 0.05);
}

.chat-header {
  display: flex;
  align-items: center;
  padding: 14px 15px;
  border-bottom: 1px solid #edf1ef;
  background: #fbfcfb;
}

.chat-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 13px;
  background: #e5f1eb;
  color: #5e9180;
  font-size: 15px;
  font-weight: 700;
}

.chat-header-copy {
  flex: 1;
  margin-left: 10px;
}

.chat-title {
  color: #26312d;
  font-size: 15px;
  font-weight: 700;
}

.chat-subtitle {
  margin-top: 3px;
  color: #89948f;
  font-size: 11px;
}

.online-mark {
  display: flex;
  align-items: center;
  color: #5e9180;
  font-size: 11px;
}

.status-dot {
  width: 6px;
  height: 6px;
  margin-right: 4px;
  border-radius: 50%;
  background: #6db08d;
}

.message-list {
  height: 540px;
  padding: 16px 14px;
  background: #f7f9f8;
}

.message {
  display: flex;
  margin-bottom: 14px;
}

.message.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 78%;
  padding: 11px 13px;
  border-radius: 15px 15px 15px 5px;
  background: #fff;
  color: #3a4741;
  font-size: 14px;
  line-height: 1.65;
  box-shadow: 0 2px 8px rgba(37, 53, 46, 0.04);
}

.message.user .bubble {
  border-radius: 15px 15px 5px 15px;
  background: #5e9180;
  color: #fff;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  padding: 12px 14px 13px;
  background: #f7f9f8;
}

.quick-button {
  margin: 0;
  padding: 6px 10px;
  border: 1px solid #c9ded4;
  border-radius: 999px;
  background: #f5faf7;
  color: #5e9180;
  font-size: 12px;
  line-height: 1.4;
}

.input-row {
  display: flex;
  gap: 8px;
  padding: 12px;
  border-top: 1px solid #e4ebe7;
  background: #fff;
}

.input {
  flex: 1;
  height: 42px;
  padding: 0 12px;
  border: 1px solid #dfe8e3;
  border-radius: 10px;
  background: #fff;
  color: #3a4741;
}

.send-button,
.lead-button {
  background: #5e9180;
  color: #fff;
  font-size: 14px;
}

.send-button {
  width: 72px;
  margin: 0;
}

.lead-button {
  margin-top: 14px;
  box-shadow: 0 5px 14px rgba(94, 145, 128, 0.16);
}

.lead-arrow {
  margin-left: 4px;
  font-size: 17px;
}
