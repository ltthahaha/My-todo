.page {
  min-height: 100vh;
  padding: 22px 20px 40px;
}

.intro {
  margin-bottom: 18px;
}

.title {
  color: #172334;
  font-size: 26px;
  font-weight: 700;
}

.description {
  margin-top: 8px;
  color: #667384;
  font-size: 14px;
  line-height: 1.6;
}

.form-card,
.success-card {
  padding: 18px;
  border: 1px solid #e4e9ef;
  border-radius: 16px;
  background: #fff;
}

.field {
  margin-bottom: 16px;
}

.label {
  margin-bottom: 7px;
  color: #4f5b68;
  font-size: 13px;
}

.input,
.picker,
.textarea {
  width: 100%;
  min-height: 42px;
  padding: 0 12px;
  border: 1px solid #e1e7ed;
  border-radius: 10px;
  background: #fff;
  color: #303943;
  font-size: 14px;
  line-height: 42px;
}

.textarea {
  height: 80px;
  padding-top: 10px;
  line-height: 1.5;
}

.picker {
  box-sizing: border-box;
}

.picker-arrow {
  float: right;
  color: #9aa7b5;
}

.primary-button {
  margin: 0;
  background: #5f9df7;
  color: #fff;
}

.privacy-note {
  margin-top: 10px;
  color: #8995a3;
  font-size: 11px;
  text-align: center;
}

.success-card {
  margin-top: 80px;
  text-align: center;
}

.success-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: #eaf8f0;
  color: #329562;
  font-size: 28px;
  font-weight: 700;
}

.success-title {
  margin-top: 16px;
  color: #20262e;
  font-size: 19px;
  font-weight: 700;
}

.success-text {
  margin: 8px 0 20px;
  color: #667384;
  font-size: 14px;
  line-height: 1.6;
}
