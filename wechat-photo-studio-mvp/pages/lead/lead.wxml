<view class="page">
  <view wx:if="{{!submitted}}">
    <view class="intro">
      <view class="title">留下咨询信息</view>
      <view class="description">门店顾问会根据你的需求和预算与你联系，具体服务内容以顾问确认结果为准。</view>
    </view>

    <view class="form-card">
      <view class="field">
        <view class="label">怎么称呼</view>
        <input class="input" data-field="name" value="{{name}}" bindinput="onInput" placeholder="例如：李小姐" />
      </view>
      <view class="field">
        <view class="label">手机号 / 微信</view>
        <input class="input" data-field="contact" value="{{contact}}" bindinput="onInput" placeholder="方便门店联系" />
      </view>
      <view class="field">
        <view class="label">感兴趣的服务</view>
        <picker mode="selector" range="{{serviceOptions}}" value="{{serviceIndex}}" bindchange="chooseService">
          <view class="picker">{{serviceType}} <text class="picker-arrow">⌄</text></view>
        </picker>
      </view>
      <view class="field">
        <view class="label">计划拍摄日期（可选）</view>
        <picker mode="date" value="{{preferredDate}}" bindchange="chooseDate">
          <view class="picker">{{preferredDate || "请选择日期"}} <text class="picker-arrow">⌄</text></view>
        </picker>
      </view>
      <view class="field">
        <view class="label">预算</view>
        <input class="input" data-field="budget" value="{{budget}}" bindinput="onInput" placeholder="例如：5000 元左右" />
      </view>
      <view class="field">
        <view class="label">想了解的内容</view>
        <textarea class="textarea" data-field="note" value="{{note}}" bindinput="onInput" placeholder="喜欢的风格、人数、拍摄地点等"></textarea>
      </view>
      <checkbox-group bindchange="onConsent" class="privacy-note"><label><checkbox value="agree" checked="{{consent}}" color="#5e9180" />同意门店根据所填联系方式联系我</label></checkbox-group>
      <view class="privacy-note" bindtap="openPrivacy">查看隐私说明</view>
      <button class="primary-button" loading="{{isSubmitting}}" disabled="{{isSubmitting || !consent}}" bindtap="submitLead">提交咨询信息</button>
      <view class="privacy-note">提交后仅用于联系你了解摄影服务，不代表下单或确认档期。</view>
    </view>
  </view>

  <view wx:else class="success-card">
    <view class="success-icon">✓</view>
    <view class="success-title">已收到你的咨询信息</view>
    <view class="success-text">门店顾问会尽快与你联系，具体价格、服务内容和拍摄时间以沟通结果为准。</view>
    <button class="primary-button" bindtap="goBack">返回继续了解</button>
  </view>
</view>
