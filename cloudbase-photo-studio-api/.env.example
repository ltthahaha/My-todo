# CloudBase environment ID. In a CloudBase cloud function this can usually
# be provided by the runtime; set it explicitly when deploying from a package.
CLOUDBASE_ENV_ID=your-cloudbase-env-id

# Required for an HTTP/Web Cloud Function. Create a server API key in
# CloudBase API key management and keep it only in server-side variables.
CLOUDBASE_APIKEY=

# Alternative authentication. Do not configure both methods.
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=

DEFAULT_STUDIO_ID=demo-studio
CLOUDBASE_FAQ_COLLECTION=faqs
CLOUDBASE_PACKAGE_COLLECTION=packages
CLOUDBASE_LEAD_COLLECTION=leads
CLOUDBASE_CHAT_COLLECTION=chat_messages
CLOUDBASE_CHAT_SESSION_COLLECTION=chat_sessions
CLOUDBASE_UNANSWERED_COLLECTION=unanswered_questions
CLOUDBASE_DOUYIN_USER_COLLECTION=douyin_users
CLOUDBASE_ADMIN_USER_COLLECTION=admin_users

# Required for Douyin miniapp user identity. Keep AppSecret server-side only.
DOUYIN_APP_ID=tt428a3437dcf0288901
DOUYIN_APP_SECRET=
DOUYIN_AUTH_TOKEN_SECRET=

# Keep this value on the server only.
FEISHU_BOT_WEBHOOK=

# Required by the lead management dashboard. Keep this server-side only.
ADMIN_API_TOKEN=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=604800

# Optional AI enhancement. Keep all model credentials server-side only.
AI_ENABLED=false
AI_PROVIDER=volcengine
ARK_API_KEY=
ARK_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
AI_TIMEOUT_MS=6000
AI_MAX_TOKENS=240
